{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Train pipeline (fast)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "retail_purchase.train", "--fast"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: build training image",
      "type": "shell",
      "command": "docker",
      "args": ["build", "--tag", "retail-purchase-prediction:local", "."],
      "problemMatcher": []
    },
    {
      "label": "Docker: train pipeline (fast)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "run", "--rm", "train"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
