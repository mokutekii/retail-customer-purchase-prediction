/artifacts/
*.joblib
*.pkl
*.pt
*.pth

# Root-level generated outputs, while retaining a placeholder if one is added
/outputs/*
!/outputs/.gitkeep

# LaTeX build artifacts
report/*.aux
report/*.log
report/*.out
report/*.bbl
report/*.blg
report/*.synctex.gz
report/*.toc
