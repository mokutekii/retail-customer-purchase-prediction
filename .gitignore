# Operating-system files
.DS_Store
Thumbs.db

# Python environments, caches, and packaging outputs
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

